<%- include('_head') %>
<% const cents = (c) => (Number(c || 0) / 100).toFixed(2); %>
<div class="top"><div><a class="muted small" href="/admin/orders">← Pedidos</a><h1>Registrar pedido</h1><div class="muted small">Para ventas hechas fuera de la web: teléfono, WhatsApp, en bodega…</div></div></div>
<% if (error) { %><div class="notice err"><%= error %></div><% } %>
<form method="post" action="/admin/orders/new">
<div class="grid cols2">
  <div class="grid" style="gap:16px">
    <div class="card">
      <h2>Productos</h2>
      <div class="table-wrap"><table class="manual-lines">
        <thead><tr><th>Producto</th><th class="num">Stock</th><th>Cantidad</th><th>Precio c/u (USD)</th><th class="num">Total</th></tr></thead>
        <tbody>
        <% products.forEach(function (p) { %>
        <tr data-line>
          <td><b><%= p.name %></b><div class="muted small"><%= p.dimensions %><%= p.active ? '' : ' · oculto en la tienda' %></div></td>
          <td class="num"><%= p.stock %></td>
          <td><input type="number" name="qty_<%= p.id %>" min="0" value="<%= form.qty[p.id] || '' %>" placeholder="0"></td>
          <td><input name="price_<%= p.id %>" inputmode="decimal" value="<%= form.price[p.id] || cents(p.price_cents) %>"></td>
          <td class="num" data-total>—</td>
        </tr>
        <% }) %>
        </tbody>
      </table></div>
      <div class="hint">El precio viene del catálogo; cámbialo si acordaste otro con el cliente.</div>
      <div class="f3" style="margin-top:14px">
        <div class="field"><label>Envío (USD)</label><input name="shipping" inputmode="decimal" value="<%= form.shipping %>" placeholder="0.00"></div>
        <div class="field"><label>Descuento (USD)</label><input name="discount" inputmode="decimal" value="<%= form.discount %>" placeholder="0.00"></div>
        <div class="field"><label>Impuesto (USD)</label><input name="tax" inputmode="decimal" value="<%= form.tax %>" placeholder="0.00"></div>
      </div>
      <p style="text-align:right;margin:4px 0 0;font-size:18px">Total: <b id="grand">$0.00</b></p>
      <label class="check"><input type="checkbox" name="allow_oversell" <%= form.allow_oversell ? 'checked' : '' %>> Vender aunque el stock del sistema no alcance (el stock queda en 0)</label>
    </div>
    <div class="card">
      <h2>Pago y estado</h2>
      <div class="f2">
        <div class="field"><label>Método de pago</label>
          <select name="payment_method"><% PAYMENTS.forEach(function (p) { %><option value="<%= p[0] %>" <%= form.payment_method === p[0] ? 'selected' : '' %>><%= p[1] %></option><% }) %></select></div>
        <div class="field"><label>Estado</label>
          <select name="status"><% ['pending', 'paid', 'shipped', 'delivered'].forEach(function (s) { %><option value="<%= s %>" <%= form.status === s ? 'selected' : '' %>><%= STATUS[s] %></option><% }) %></select></div>
      </div>
      <div class="field"><label>Notas internas</label><textarea name="notes" rows="3"><%= form.notes || '' %></textarea></div>
    </div>
  </div>
  <div class="grid" style="gap:16px">
    <div class="card">
      <h2>Cliente</h2>
      <div class="field" style="position:relative">
        <label>Buscar cliente existente</label>
        <input id="custSearch" autocomplete="off" placeholder="Nombre, correo o teléfono...">
        <div id="custResults" class="card" style="display:none;position:absolute;z-index:5;top:100%;left:0;right:0;padding:6px;margin-top:4px;max-height:220px;overflow:auto"></div>
      </div>
      <div class="field"><label>Nombre *</label><input name="name" id="f_name" required value="<%= form.name || '' %>"></div>
      <div class="f2">
        <div class="field"><label>Correo</label><input name="email" id="f_email" type="email" value="<%= form.email || '' %>" placeholder="Opcional"></div>
        <div class="field"><label>Teléfono</label><input name="phone" id="f_phone" value="<%= form.phone || '' %>"></div>
      </div>
      <div class="hint">Con correo, el pedido queda en el historial del cliente.</div>
      <div class="f2" style="margin-top:10px;align-items:center">
        <label class="check"><input type="checkbox" name="send_email" <%= form.send_email ? 'checked' : '' %>> Enviarle confirmación por correo</label>
        <div class="field" style="margin:0"><select name="lang"><option value="es" <%= form.lang !== 'en' ? 'selected' : '' %>>Correo en español</option><option value="en" <%= form.lang === 'en' ? 'selected' : '' %>>Email in English</option></select></div>
      </div>
    </div>
    <div class="card">
      <h2>Entrega</h2>
      <label class="check"><input type="radio" name="fulfillment" value="pickup" id="f_pickup" <%= form.fulfillment !== 'delivery' ? 'checked' : '' %>> Recoge / entregado en persona</label>
      <label class="check"><input type="radio" name="fulfillment" value="delivery" id="f_delivery" <%= form.fulfillment === 'delivery' ? 'checked' : '' %>> Envío a dirección</label>
      <div id="addr" style="margin-top:10px">
        <div class="field"><label>Dirección</label><input name="address1" id="f_address1" value="<%= form.address1 || '' %>"></div>
        <div class="field"><label>Apto / suite</label><input name="address2" id="f_address2" value="<%= form.address2 || '' %>"></div>
        <div class="f3">
          <div class="field"><label>Ciudad</label><input name="city" id="f_city" value="<%= form.city || '' %>"></div>
          <div class="field"><label>Estado</label><input name="state" id="f_state" maxlength="2" value="<%= form.state || '' %>" placeholder="TX" style="text-transform:uppercase"></div>
          <div class="field"><label>ZIP</label><input name="zip" id="f_zip" value="<%= form.zip || '' %>"></div>
        </div>
      </div>
    </div>
    <button class="btn orange" style="justify-content:center;padding:13px">Registrar pedido</button>
  </div>
</div>
</form>
<script>
(function () {
  var f = document.querySelector('form[action="/admin/orders/new"]');
  var num = function (v) { var n = parseFloat(String(v).replace(/[$,\s]/g, '')); return isFinite(n) ? n : 0; };
  var fmt = function (n) { return '$' + n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); };
  function sync() {
    var sub = 0;
    f.querySelectorAll('[data-line]').forEach(function (tr) {
      var q = num(tr.querySelector('input[name^=qty_]').value), p = num(tr.querySelector('input[name^=price_]').value);
      tr.querySelector('[data-total]').textContent = q ? fmt(q * p) : '—';
      sub += q * p;
    });
    var total = sub - Math.min(num(f.discount.value), sub) + num(f.shipping.value) + num(f.tax.value);
    document.getElementById('grand').textContent = fmt(total);
    document.getElementById('addr').hidden = f.querySelector('input[name=fulfillment]:checked').value !== 'delivery';
  }
  f.addEventListener('input', sync); f.addEventListener('change', sync); sync();
})();
(function () {
  var input = document.getElementById('custSearch'), box = document.getElementById('custResults');
  var timer = null;
  function esc(s) { return String(s || '').replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
  function hide() { box.style.display = 'none'; box.innerHTML = ''; }
  function pick(c) {
    document.getElementById('f_name').value = c.name || '';
    document.getElementById('f_email').value = c.email || '';
    document.getElementById('f_phone').value = c.phone || '';
    if (c.address1) {
      document.getElementById('f_delivery').checked = true;
      document.getElementById('f_address1').value = c.address1 || '';
      document.getElementById('f_address2').value = c.address2 || '';
      document.getElementById('f_city').value = c.city || '';
      document.getElementById('f_state').value = c.state || '';
      document.getElementById('f_zip').value = c.zip || '';
    }
    input.value = c.name + ' — ' + c.email;
    hide();
    f.dispatchEvent(new Event('change'));
  }
  input.addEventListener('input', function () {
    clearTimeout(timer);
    var q = input.value.trim();
    if (q.length < 2) return hide();
    timer = setTimeout(function () {
      fetch('/admin/orders/customer-search?q=' + encodeURIComponent(q)).then(function (r) { return r.json(); }).then(function (rows) {
        if (!rows.length) return hide();
        box.innerHTML = rows.map(function (c, i) {
          var addr = c.city ? [c.city, c.state].filter(Boolean).join(', ') : '';
          return '<div class="custrow" data-i="' + i + '" style="padding:8px;border-radius:6px;cursor:pointer"><b>' + esc(c.name) + '</b><br><span class="muted small">' + esc(c.email) + (c.phone ? ' · ' + esc(c.phone) : '') + (addr ? ' · ' + esc(addr) : '') + '</span></div>';
        }).join('');
        box.style.display = 'block';
        box.querySelectorAll('.custrow').forEach(function (row) {
          row.addEventListener('mouseenter', function () { row.style.background = '#F5F3EF'; });
          row.addEventListener('mouseleave', function () { row.style.background = ''; });
          row.addEventListener('click', function () { pick(rows[Number(row.dataset.i)]); });
        });
      }).catch(function () { hide(); });
    }, 250);
  });
  document.addEventListener('click', function (e) { if (e.target !== input) hide(); });
})();
</script>
<%- include('_foot') %>
