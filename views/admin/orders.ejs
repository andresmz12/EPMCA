<%- include('_head') %>
<% const qs = (o) => { const p = new URLSearchParams(); const v = Object.assign({ status, q: search }, o); for (const k in v) if (v[k]) p.set(k, v[k]); const s = p.toString(); return s ? '?' + s : ''; }; %>
<div class="top"><div><h1>Pedidos</h1><div class="muted small"><%= total %> resultados</div></div>
  <div style="display:flex;gap:8px;flex-wrap:wrap">
    <a class="btn ghost sm" href="/admin/orders/export.xlsx<%= qs({}) %>">Excel</a>
    <a class="btn ghost sm" href="/admin/orders/export.csv<%= qs({}) %>">CSV</a>
    <a class="btn orange sm" href="/admin/orders/new">+ Registrar pedido</a>
  </div>
</div>
<div class="filters">
  <div class="tabs">
    <a class="<%= !status ? 'on' : '' %>" href="/admin/orders<%= qs({ status: '' , page: '' }) %>">Todos</a>
    <% Object.keys(STATUS).forEach(function (s) { %><a class="<%= status===s ? 'on' : '' %>" href="/admin/orders<%= qs({ status: s, page: '' }) %>"><%= STATUS[s] %> <span class="muted">(<%= counts[s] || 0 %>)</span></a><% }) %>
  </div>
  <form method="get"><% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %><input name="q" value="<%= search %>" placeholder="Buscar por # pedido, nombre o correo"><button class="btn sm">Buscar</button></form>
</div>
<form method="post" action="/admin/orders/delete" id="bulk">
<div class="card"><div class="table-wrap"><table>
  <thead><tr><% if (can.users) { %><th style="width:34px"><input type="checkbox" id="selall" aria-label="Seleccionar todos" style="width:auto"></th><% } %><th>Pedido</th><th>Fecha</th><th>Cliente</th><th>Entrega</th><th class="num">Cajas</th><th>Estado</th><th class="num">Total</th></tr></thead>
  <tbody>
  <% if (!list.length) { %><tr><td colspan="8" class="muted">No hay pedidos con esos filtros.</td></tr><% } %>
  <% list.forEach(function (o) { %>
  <tr>
    <% if (can.users) { %><td><input type="checkbox" name="ids" value="<%= o.id %>" class="selrow" aria-label="Seleccionar <%= o.number %>" style="width:auto"></td><% } %>
    <td><a href="/admin/orders/<%= o.id %>"><b><%= o.number %></b></a><% if (o.source === 'admin') { %><div class="muted small">Registrado en admin</div><% } %></td>
    <td class="small"><%= fmtDate(o.created_at) %></td>
    <td><%= o.name %><div class="muted small"><%= o.email %></div></td>
    <td class="small"><%= o.fulfillment === 'pickup' ? 'Recoge' : o.city + ', ' + o.state %></td>
    <td class="num"><%= o.units %></td>
    <td><span class="pill <%= o.status %>"><%= STATUS[o.status] %></span></td>
    <td class="num"><b><%= money(o.total_cents) %></b></td>
  </tr>
  <% }) %>
  </tbody>
</table></div></div>
<% if (can.users && list.length) { %>
<div class="card" id="bulkbar" style="margin-top:12px;display:flex;align-items:center;gap:14px;flex-wrap:wrap">
  <button class="btn danger sm" id="bulkbtn" disabled>Eliminar seleccionados</button>
  <label class="check" style="margin:0"><input type="checkbox" name="restock" checked> Devolver las cajas al inventario</label>
  <span class="muted small" id="bulkcount">Marca los pedidos de prueba que quieras borrar. Esto no se puede deshacer.</span>
</div>
<% } %>
</form>
<% if (can.users) { %><script>
(function () {
  var f = document.getElementById('bulk'); if (!f) return;
  var rows = [].slice.call(f.querySelectorAll('.selrow')), all = document.getElementById('selall'), btn = document.getElementById('bulkbtn'), cnt = document.getElementById('bulkcount');
  function upd() { var n = rows.filter(function (r) { return r.checked; }).length; if (btn) btn.disabled = !n; if (cnt) cnt.textContent = n ? n + ' pedido' + (n === 1 ? '' : 's') + ' seleccionado' + (n === 1 ? '' : 's') + '. Esto no se puede deshacer.' : 'Marca los pedidos de prueba que quieras borrar. Esto no se puede deshacer.'; }
  rows.forEach(function (r) { r.addEventListener('change', upd); });
  if (all) all.addEventListener('change', function () { rows.forEach(function (r) { r.checked = all.checked; }); upd(); });
  f.addEventListener('submit', function (e) {
    var n = rows.filter(function (r) { return r.checked; }).length;
    if (!n || !window.confirm('¿Eliminar ' + n + ' pedido' + (n === 1 ? '' : 's') + ' para siempre? Esto no se puede deshacer.')) e.preventDefault();
  });
})();
</script><% } %>
<% if (pages > 1) { %><div style="display:flex;gap:8px;justify-content:center;margin-top:16px">
  <% if (page > 1) { %><a class="btn ghost sm" href="/admin/orders<%= qs({ page: page - 1 }) %>">← Anterior</a><% } %>
  <span class="muted small" style="align-self:center">Página <%= page %> de <%= pages %></span>
  <% if (page < pages) { %><a class="btn ghost sm" href="/admin/orders<%= qs({ page: page + 1 }) %>">Siguiente →</a><% } %>
</div><% } %>
<%- include('_foot') %>
