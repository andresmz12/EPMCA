<%- include('_head') %>
<div class="top"><h1>Usuarios admin</h1></div>
<div class="grid cols2">
  <div class="card"><div class="table-wrap"><table>
    <thead><tr><th>Correo</th><th>Acceso</th><th>Desde</th><th></th></tr></thead>
    <tbody>
    <% list.forEach(function (u) { %>
    <tr>
      <td><b><%= u.email %></b><% if (u.id === admin.id) { %> <span class="pill on">Tú</span><% } %></td>
      <td class="small">
        <% if (u.role === 'owner') { %>Administrador completo<% } else { %>
          <%= [u.perm_orders && 'Pedidos y clientes', u.perm_products && 'Productos y cupones'].filter(Boolean).join(' + ') || 'Sin permisos' %>
        <% } %>
      </td>
      <td class="small"><%= fmtDate(u.created_at, false) %></td>
      <td class="num">
        <% if (u.id !== admin.id) { %>
        <form method="post" action="/admin/users/<%= u.id %>/delete" style="display:inline" data-confirm="¿Eliminar el acceso de <%= u.email %>?"><button class="btn danger sm">Eliminar</button></form>
        <% } %>
      </td>
    </tr>
    <% }) %>
    </tbody>
  </table></div></div>
  <form class="card" method="post" action="/admin/users">
    <h2>Agregar admin</h2>
    <p class="hint" style="margin-top:-6px">Dale acceso al panel a otra persona de tu equipo, con solo lo que necesita ver.</p>
    <% if (error) { %><div class="notice err"><%= error %></div><% } %>
    <div class="field"><label>Correo</label><input name="email" type="email" required placeholder="nombre@empacalo.net"></div>
    <div class="field"><label>Contraseña</label><input name="password" type="password" required minlength="8" placeholder="Mínimo 8 caracteres"></div>
    <div class="field">
      <label>Permisos</label>
      <label class="check"><input type="checkbox" name="perm_orders" class="permchk"> Pedidos y clientes</label>
      <label class="check"><input type="checkbox" name="perm_products" class="permchk"> Productos y cupones (precio, stock, fotos y descripciones)</label>
      <label class="check"><input type="checkbox" name="role" value="owner" id="roleowner"> Administrador completo (incluye Configuración del sitio y poder crear/quitar otros admins)</label>
    </div>
    <div class="hint" style="margin:-6px 0 14px">Configuración (textos, imágenes, envíos, WhatsApp) solo la puede tocar un Administrador completo.</div>
    <button class="btn orange" style="width:100%;justify-content:center">Crear admin</button>
  </form>
</div>
<script>
(function () {
  var owner = document.getElementById('roleowner');
  var perms = document.querySelectorAll('.permchk');
  owner.addEventListener('change', function () {
    perms.forEach(function (p) { p.disabled = owner.checked; });
  });
})();
</script>
<%- include('_foot') %>
