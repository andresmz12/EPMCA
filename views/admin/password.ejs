<%- include('_head') %>
<div class="top"><h1>Mi contraseña</h1></div>
<form class="card" method="post" action="/admin/password" style="max-width:440px">
  <p class="hint" style="margin-top:0">Sesión iniciada como <b><%= admin.email %></b>.</p>
  <% if (error) { %><div class="notice err"><%= error %></div><% } %>
  <div class="field"><label>Contraseña actual</label><input name="current_password" type="password" required autocomplete="current-password"></div>
  <div class="field"><label>Nueva contraseña</label><input name="new_password" type="password" required minlength="8" autocomplete="new-password"></div>
  <div class="field"><label>Repite la nueva contraseña</label><input name="confirm_password" type="password" required minlength="8" autocomplete="new-password"></div>
  <button class="btn orange" style="width:100%;justify-content:center">Cambiar contraseña</button>
</form>
<%- include('_foot') %>
