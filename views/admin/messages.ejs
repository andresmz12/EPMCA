<%- include('_head') %>
<div class="top"><div><h1>Mensajes</h1><div class="muted small"><%= list.length %> mensajes</div></div></div>
<% if (!list.length) { %>
<div class="card"><p class="muted">Todavía no hay mensajes de contacto.</p></div>
<% } %>
<% list.forEach(function (m) { %>
<div class="card" style="margin-bottom:14px<%= m.read ? '' : ';border-left:4px solid var(--orange)' %>">
  <div class="top" style="margin-bottom:10px;align-items:flex-start">
    <dl class="msg-fields">
      <div><dt>Nombre</dt><dd><%= m.name %></dd></div>
      <% if (m.phone) { %><div><dt>Teléfono</dt><dd><a href="tel:<%= m.phone.replace(/[^\d+]/g, '') %>"><%= m.phone %></a></dd></div><% } %>
      <% if (m.email) { %><div><dt>Correo</dt><dd><a href="mailto:<%= m.email %>"><%= m.email %></a></dd></div><% } %>
      <div><dt>Mensaje</dt><dd style="white-space:pre-wrap"><%= m.message %></dd></div>
      <div><dt>Fecha</dt><dd class="muted"><%= fmtDate(m.created_at) %></dd></div>
    </dl>
    <div style="display:flex;gap:8px;flex-wrap:wrap;flex-shrink:0">
      <% if (m.phone) { const dg = m.phone.replace(/[^\d+]/g, ''); %>
      <a class="btn ghost sm" href="tel:<%= dg %>">Llamar</a>
      <a class="btn ghost sm" href="https://wa.me/<%= dg.replace(/^\+/, '') %>" target="_blank" rel="noopener">WhatsApp</a>
      <% } %>
      <form method="post" action="/admin/messages/<%= m.id %>/read"><button class="btn ghost sm"><%= m.read ? 'Marcar sin leer' : 'Marcar leído' %></button></form>
      <form method="post" action="/admin/messages/<%= m.id %>/delete" data-confirm="¿Eliminar este mensaje?"><button class="btn danger sm">Eliminar</button></form>
    </div>
  </div>
</div>
<% }) %>
<%- include('_foot') %>
