<%- include('_head') %>
<div class="wrap page">
  <div style="max-width:480px;margin:0 auto">
    <h1 style="font-size:30px"><%= t('track_title') %></h1>
    <p class="muted"><%= t('track_sub') %></p>
    <% if (error) { %><div class="flash err"><%= error %></div><% } %>
    <form method="post" action="/track" class="panel">
      <div class="field"><label for="number"><%= t('track_number') %></label><input id="number" name="number" required value="<%= form.number || '' %>" placeholder="BX-XXXXXXXX" autocomplete="off" style="text-transform:uppercase"></div>
      <div class="field"><label for="contact"><%= t('track_contact') %></label><input id="contact" name="contact" required value="<%= form.contact || '' %>" autocomplete="email"></div>
      <div class="hint" style="margin:-6px 0 14px"><%= t('track_hint') %></div>
      <button class="btn orange block"><%= t('track_btn') %></button>
    </form>
    <p class="muted small" style="margin-top:16px"><%= t('track_account_note') %> <a class="textlink" href="/account/login"><%= t('account_login') %></a></p>
  </div>
</div>
<%- include('_foot') %>
