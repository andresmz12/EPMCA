<%- include('_head') %>
<div class="wrap page">
  <div style="max-width:440px;margin:0 auto">
    <h1 style="font-size:28px"><%= t('reset_title') %></h1>
    <% if (error) { %><div class="flash err"><%= error %></div><% } %>
    <% if (token) { %>
      <form method="post" action="/account/reset/<%= token %>" class="panel">
        <div class="field"><label for="password"><%= t('password') %></label><input id="password" type="password" name="password" required minlength="8" autocomplete="new-password" autofocus></div>
        <div class="hint" style="margin:-8px 0 14px"><%= t('account_password_hint') %></div>
        <button class="btn orange block"><%= t('reset_save') %></button>
      </form>
    <% } else { %>
      <p><a class="btn orange" href="/account/forgot"><%= t('forgot_send') %></a></p>
    <% } %>
  </div>
</div>
<%- include('_foot') %>
