<% if (p.image_id) { %><img src="/img/<%= p.image_id %>" alt="<%= pt(p, 'name') %>" loading="lazy">
<% } else if (p.category === 'supply') { %><%- supplySvg(/scale/i.test(p.slug) ? 'scale' : 'roll') %>
<% } else { %><%- boxSvg(p.dimensions, { fixed: typeof fixed !== 'undefined' && fixed, label: !(typeof fixed !== 'undefined' && fixed) }) %><% } %>
