<%- include('_head') %>
<div class="wrap page">
  <div class="authwrap">
    <div class="perks">
      <h2><%= t('perks_title') %></h2>
      <ul>
        <li><span class="ico">&#128230;</span><span><%= t('perks_track') %></span></li>
        <li><span class="ico">&#9889;</span><span><%= t('perks_fast') %></span></li>
        <li><span class="ico">&#128257;</span><span><%= t('perks_recurring') %></span></li>
      </ul>
      <div class="promo"><b><%= t('promo_pct') %></b> <%= t('promo_new_account_hidden') %></div>
    </div>
    <div class="form-side">
      <h1><%= t('account_create') %></h1>
      <p class="sub"><%= t('account_create_sub') %></p>
      <% if (error) { %><div class="flash err"><%= error %></div><% } %>
      <form method="post" action="/account/register">
        <div class="field"><label for="name"><%= t('full_name') %></label><input id="name" name="name" required autocomplete="name" value="<%= form.name || '' %>"></div>
        <div class="field"><label for="email"><%= t('email') %></label><input id="email" type="email" name="email" required autocomplete="email" value="<%= form.email || '' %>"></div>
        <div class="field"><label for="password"><%= t('password') %></label><input id="password" type="password" name="password" required minlength="8" autocomplete="new-password"></div>
        <div class="hint" style="margin:-8px 0 14px"><%= t('account_password_hint') %></div>
        <button class="btn orange block"><%= t('account_create') %></button>
      </form>
      <p class="muted small" style="margin-top:16px"><%= t('account_has_account') %> <a class="textlink" href="/account/login"><%= t('account_login') %></a></p>
    </div>
  </div>
</div>
<%- include('_foot') %>
