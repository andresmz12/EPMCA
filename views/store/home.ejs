<%- include('_head') %>
<%
  const boxes = products.filter(p => p.category !== 'supply');
  const doubleBoxes = boxes.filter(p => p.wall_type !== 'single');
  const singleBoxes = boxes.filter(p => p.wall_type === 'single');
  const supplies = products.filter(p => p.category === 'supply');
  const minPrice = boxes.length ? Math.min(...boxes.map(p => p.price_cents)) : 0;
  const flat = Number(settings.shipping_flat_cents || 0), freeMin = Number(settings.free_shipping_min_cents || 0);
  const dimsOf = (p) => (String(p.dimensions).match(/\d+(\.\d+)?/g) || []).map(Number);
  const heroBoxes = boxes.filter(p => dimsOf(p).length >= 3).slice().sort((a, b) => dimsOf(a).reduce((x, y) => x * y, 1) - dimsOf(b).reduce((x, y) => x * y, 1));
%>
<section class="hero">
  <div class="wrap">
    <div>
      <div class="eyebrow"><%= t('hero_eyebrow') %></div>
      <h1><%= t('hero_title') %></h1>
      <p class="lead"><%= t('hero_sub') %></p>
      <div class="ctas">
        <a class="btn orange" href="#shop"><%= t('hero_cta') %></a>
      </div>
      <ul class="facts">
        <% if (minPrice) { %><li><b><%= money(minPrice) %></b><%= t('fact_price_lbl') %></li><% } %>
        <li><b>275 lb</b><%= t('fact_strength_lbl') %></li>
        <li><b><%= t('fact_ship_big') %></b><%= t('fact_ship_lbl') %></li>
      </ul>
      <a class="wholesale-teaser" href="#wholesale"><%= t('hero_wholesale_link') %></a>
    </div>
    <% if (settings.hero_image_id) { %>
      <figure class="art photo"><img src="/img/<%= settings.hero_image_id %>" alt="<%= settings.store_name %>"></figure>
    <% } else { %>
      <figure class="art" aria-label="<%= t('art_caption') %>">
        <div class="row-boxes">
          <% heroBoxes.forEach(function (p) { %>
            <div><%- boxSvg(p.dimensions, { fixed: true, label: false }) %></div>
          <% }) %>
        </div>
        <div class="rule"></div>
        <figcaption><span><%= t('art_caption') %></span><span><%= heroBoxes.map(p => dimsOf(p).join('×')).join(' · ') %></span></figcaption>
      </figure>
    <% } %>
  </div>
</section>

<section class="block" id="shop">
  <div class="wrap">
    <div class="section-head"><h2><%= t('shop_title') %></h2><p><%= t('shop_sub') %></p></div>
    <% [
      { title: t('wall_double_title'), sub: t('wall_double_sub'), list: doubleBoxes },
      { title: t('wall_single_title'), sub: t('wall_single_sub'), list: singleBoxes },
    ].forEach(function (grp) { if (!grp.list.length) return; %>
    <div class="wall-group">
      <h3 class="wall-group-title"><%= grp.title %></h3>
      <p class="wall-group-sub"><%= grp.sub %></p>
      <div class="grid">
        <% grp.list.forEach(function (p) { %>
        <article class="card">
          <a class="pic <%= p.image_id ? 'has-img' : '' %>" href="/products/<%= p.slug %>"><%- include('_pic', { p, fixed: true }) %></a>
          <% if (p.featured) { %><span class="tagline"><%= t('popular') %></span><% } %>
          <div class="body">
            <a class="name" href="/products/<%= p.slug %>"><%= pt(p, 'name') %></a>
            <p class="desc"><%= pt(p, 'short_desc') %></p>
            <div class="price"><%= money(p.price_cents) %><% if (p.compare_at_cents > p.price_cents) { %><s><%= money(p.compare_at_cents) %></s><span class="badge-off">-<%= Math.round((1 - p.price_cents / p.compare_at_cents) * 100) %>%</span><% } %> <span class="per"><%= p.pack_size > 1 ? '' : t('per_box') %></span></div>
            <%- include('_stock', { p }) %>
            <form method="post" action="/cart/add">
              <input type="hidden" name="product_id" value="<%= p.id %>">
              <input type="number" name="qty" value="<%= p.pack_size > 1 ? 1 : 10 %>" min="1" max="<%= Math.max(1, p.stock) %>" aria-label="<%= t('qty') %>" <%= p.stock <= 0 ? 'disabled' : '' %>>
              <button class="btn" <%= p.stock <= 0 ? 'disabled' : '' %>><%= t('add_to_cart') %></button>
            </form>
          </div>
        </article>
        <% }) %>
      </div>
    </div>
    <% }) %>
  </div>
</section>

<% const wholesaleBoxes = boxes.filter(p => wholesaleTiers(p).length); %>
<% const wholesaleDouble = doubleBoxes.filter(p => wholesaleTiers(p).length); %>
<% const wholesaleSingle = singleBoxes.filter(p => wholesaleTiers(p).length); %>
<% if (wholesaleBoxes.length) { %>
<section class="block" id="wholesale">
  <div class="wrap">
    <div class="section-head"><h2><%= t('wholesale_section_title') %></h2><p><%= t('wholesale_section_sub') %></p></div>
    <div class="wholesale-badge"><%= t('wholesale_min_order', { n: 50 }) %></div>
    <% [
      { title: t('wall_double_title'), list: wholesaleDouble },
      { title: t('wall_single_title'), list: wholesaleSingle },
    ].forEach(function (grp) { if (!grp.list.length) return; %>
    <h3 class="wall-group-title"><%= grp.title %></h3>
    <div class="table-scroll">
      <table class="sizes">
        <thead><tr>
          <th><%= t('wholesale_col_size') %></th><th><%= t('wholesale_col_type') %></th>
          <th class="num">50+</th><th class="num">100+</th><th class="num">200+</th>
          <th class="num">300+</th><th class="num">400+</th><th class="num">500+</th>
        </tr></thead>
        <tbody>
        <% grp.list.forEach(function (p) { const wtiers = wholesaleTiers(p); const byQty = Object.fromEntries(wtiers.map(t2 => [t2.qty, t2.cents])); %>
          <tr>
            <td><a href="/products/<%= p.slug %>"><%= p.dimensions || pt(p, 'name') %></a></td>
            <td><%= p.wall_type === 'single' ? t('strength_val_single') : t('strength_val') %></td>
            <% [50, 100, 200, 300, 400, 500].forEach(function (q) { %>
              <td class="num"><%= byQty[q] != null ? money(byQty[q]) : '—' %></td>
            <% }) %>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
    <% }) %>
    <div class="wholesale-cta">
      <% const waMsg = t('wa_wholesale'); %>
      <% if (settings.whatsapp_number) { %>
        <a class="btn orange" href="https://wa.me/<%= settings.whatsapp_number %>?text=<%= encodeURIComponent(waMsg) %>" target="_blank" rel="noopener"><%= t('wholesale_cta') %></a>
      <% } else { %>
        <a class="btn orange" href="/contact"><%= t('wholesale_cta') %></a>
      <% } %>
      <span class="muted small"><%= t('wholesale_cta_note') %></span>
    </div>
  </div>
</section>
<% } %>

<% if (supplies.length) { %>
<section class="block alt" id="supplies">
  <div class="wrap">
    <div class="section-head"><h2><%= t('supplies_title') %></h2><p><%= t('supplies_sub') %></p></div>
    <div class="grid">
      <% supplies.forEach(function (p) { %>
      <article class="card">
        <a class="pic <%= p.image_id ? 'has-img' : '' %>" href="/products/<%= p.slug %>"><%- include('_pic', { p, fixed: true }) %></a>
        <div class="body">
          <a class="name" href="/products/<%= p.slug %>"><%= pt(p, 'name') %></a>
          <p class="desc"><%= pt(p, 'short_desc') %></p>
          <div class="price"><%= money(p.price_cents) %> <span class="per"><%= p.pack_size > 1 ? '' : t('per_unit') %></span></div>
          <%- include('_stock', { p }) %>
          <form method="post" action="/cart/add">
            <input type="hidden" name="product_id" value="<%= p.id %>">
            <input type="number" name="qty" value="1" min="1" max="<%= Math.max(1, p.stock) %>" aria-label="<%= t('qty') %>" <%= p.stock <= 0 ? 'disabled' : '' %>>
            <button class="btn" <%= p.stock <= 0 ? 'disabled' : '' %>><%= t('add_to_cart') %></button>
          </form>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="block" id="shipping">
  <div class="wrap">
    <div class="info">
      <div><h3><%= t('info_ship_t') %></h3><p><%= t('info_ship_d') %><% if (freeMin) { %> <%= t('info_ship_free', { min: money(freeMin) }) %><% } %></p></div>
      <div><h3><%= t('info_pay_t') %></h3><p><%= payEnabled ? t('info_pay_d_stripe') : t('info_pay_d_manual') %></p></div>
      <div><h3><%= t('info_bulk_t') %></h3><p><%= t('info_bulk_d', { email: settings.support_email }) %></p></div>
    </div>
  </div>
</section>

<section class="block alt" id="faq">
  <div class="wrap">
    <div class="section-head"><h2><%= t('faq_title') %></h2></div>
    <div class="faq">
      <% [1,2,3,4,5,6].forEach(function (n, i) { %>
      <details class="faq-item" <%= i === 0 ? 'open' : '' %>>
        <summary><%= t('faq_' + n + '_q') %></summary>
        <p><%= t('faq_' + n + '_a', { flat: money(flat), min: money(freeMin) }) %></p>
      </details>
      <% }) %>
    </div>
  </div>
</section>
<%- include('_foot') %>
