<%- include('_head') %>
<%
  const minPrice = products.length ? Math.min(...products.map(p => p.price_cents)) : 0;
  const flat = Number(settings.shipping_flat_cents || 0), freeMin = Number(settings.free_shipping_min_cents || 0);
  const dimsOf = (p) => (String(p.dimensions).match(/\d+(\.\d+)?/g) || []).map(Number);
  const heroBoxes = products.filter(p => dimsOf(p).length >= 3).slice().sort((a, b) => dimsOf(a).reduce((x, y) => x * y, 1) - dimsOf(b).reduce((x, y) => x * y, 1));
%>
<section class="hero">
  <div class="wrap">
    <div>
      <div class="eyebrow"><%= t('hero_eyebrow') %></div>
      <h1><%= t('hero_title') %></h1>
      <p class="lead"><%= t('hero_sub') %></p>
      <div class="ctas">
        <a class="btn orange" href="#shop"><%= t('hero_cta') %></a>
        <a class="textlink" href="#sizes"><%= t('hero_cta2') %></a>
      </div>
      <ul class="facts">
        <% if (minPrice) { %><li><b><%= money(minPrice) %></b><%= t('fact_price_lbl') %></li><% } %>
        <li><b>275 lb</b><%= t('fact_strength_lbl') %></li>
        <li><b><%= t('fact_ship_big') %></b><%= t('fact_ship_lbl') %></li>
      </ul>
    </div>
    <% if (settings.hero_image_id) { %>
      <figure class="art photo"><img src="/img/<%= settings.hero_image_id %>" alt="<%= settings.store_name %>"></figure>
    <% } else { %>
      <figure class="art" aria-label="<%= t('art_caption') %>">
        <div class="row-boxes">
          <% heroBoxes.forEach(function (p) { %>
            <div><%- boxSvg(p.dimensions, { fixed: true, label: false }) %></div>
          <% }) %>
        </div>
        <div class="rule"></div>
        <figcaption><span><%= t('art_caption') %></span><span><%= heroBoxes.map(p => dimsOf(p).join('×')).join(' · ') %></span></figcaption>
      </figure>
    <% } %>
  </div>
</section>

<section class="block" id="shop">
  <div class="wrap">
    <div class="section-head"><h2><%= t('shop_title') %></h2><p><%= t('shop_sub') %></p></div>
    <div class="grid">
      <% products.forEach(function (p) { %>
      <article class="card">
        <a class="pic <%= p.image_id ? 'has-img' : '' %>" href="/products/<%= p.slug %>"><%- include('_pic', { p, fixed: true }) %></a>
        <% if (p.featured) { %><span class="tagline"><%= t('popular') %></span><% } %>
        <div class="body">
          <a class="name" href="/products/<%= p.slug %>"><%= pt(p, 'name') %></a>
          <p class="desc"><%= pt(p, 'short_desc') %></p>
          <div class="price"><%= money(p.price_cents) %><% if (p.compare_at_cents > p.price_cents) { %><s><%= money(p.compare_at_cents) %></s><span class="badge-off">-<%= Math.round((1 - p.price_cents / p.compare_at_cents) * 100) %>%</span><% } %> <span class="per"><%= p.pack_size > 1 ? '' : t('per_box') %></span></div>
          <%- include('_stock', { p }) %>
          <form method="post" action="/cart/add">
            <input type="hidden" name="product_id" value="<%= p.id %>">
            <input type="number" name="qty" value="<%= p.pack_size > 1 ? 1 : 10 %>" min="1" max="<%= Math.max(1, p.stock) %>" aria-label="<%= t('qty') %>" <%= p.stock <= 0 ? 'disabled' : '' %>>
            <button class="btn" <%= p.stock <= 0 ? 'disabled' : '' %>><%= t('add_to_cart') %></button>
          </form>
        </div>
      </article>
      <% }) %>
    </div>
  </div>
</section>

<section class="block alt" id="sizes">
  <div class="wrap">
    <div class="section-head"><h2><%= t('chart_title') %></h2><p><%= t('chart_sub') %></p></div>
    <div class="table-scroll">
      <table class="sizes">
        <thead><tr><th><%= t('col_size') %></th><th class="num"><%= t('col_volume') %></th><th><%= t('col_strength') %></th><th class="num"><%= t('col_price') %></th><th><%= t('col_stock') %></th></tr></thead>
        <tbody>
        <% products.forEach(function (p) { const d = dimsOf(p); const vol = d.length >= 3 ? (d[0] * d[1] * d[2] / 1728) : null; %>
          <tr>
            <td><a href="/products/<%= p.slug %>"><%= p.dimensions || pt(p, 'name') %></a></td>
            <td class="num"><%= vol ? vol.toFixed(vol < 10 ? 1 : 0) + ' ' + t('cuft') : '—' %></td>
            <td><%= t('strength_val') %></td>
            <td class="num"><b><%= money(p.price_cents) %></b></td>
            <td><%- include('_stock', { p }) %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="block" id="shipping">
  <div class="wrap">
    <div class="info">
      <div><h3><%= t('info_ship_t') %></h3><p><%= t('info_ship_d') %><% if (freeMin) { %> <%= t('info_ship_free', { min: money(freeMin) }) %><% } %></p></div>
      <div><h3><%= t('info_pay_t') %></h3><p><%= stripeEnabled ? t('info_pay_d_stripe') : t('info_pay_d_manual') %></p></div>
      <div><h3><%= t('info_bulk_t') %></h3><p><%= t('info_bulk_d', { email: settings.support_email }) %></p></div>
    </div>
  </div>
</section>

<section class="block alt" id="faq">
  <div class="wrap">
    <div class="section-head"><h2><%= t('faq_title') %></h2></div>
    <div class="faq">
      <% [1,2,3,4].forEach(function (n) { %>
      <div><h3><%= t('faq_' + n + '_q') %></h3><p><%= t('faq_' + n + '_a', { flat: money(flat), min: money(freeMin) }) %></p></div>
      <% }) %>
    </div>
  </div>
</section>
<%- include('_foot') %>
