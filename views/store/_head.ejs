<!doctype html>
<html lang="<%= lang %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<%
  const pageTitle = title ? title + ' | ' + settings.store_name : settings.store_name + ' | ' + t('hero_title');
  const pageDesc = locals.description || t('hero_sub');
  const indexable = !locals.noindex;
  const ogImg = siteUrl + (locals.ogImage || (settings.hero_image_id ? '/img/' + settings.hero_image_id : '/logo.png'));
%>
<title><%= pageTitle %></title>
<meta name="description" content="<%= pageDesc %>">
<% if (indexable) { %>
<link rel="canonical" href="<%= altUrl(lang) %>">
<link rel="alternate" hreflang="en" href="<%= altUrl('en') %>">
<link rel="alternate" hreflang="es" href="<%= altUrl('es') %>">
<link rel="alternate" hreflang="x-default" href="<%= altUrl('en') %>">
<% } else { %>
<meta name="robots" content="noindex, follow">
<% } %>
<meta property="og:site_name" content="<%= settings.store_name %>">
<meta property="og:type" content="<%= locals.ogType || 'website' %>">
<meta property="og:title" content="<%= pageTitle %>">
<meta property="og:description" content="<%= pageDesc %>">
<meta property="og:url" content="<%= altUrl(lang) %>">
<meta property="og:image" content="<%= ogImg %>">
<meta property="og:locale" content="<%= lang === 'es' ? 'es_US' : 'en_US' %>">
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#EEA331">
<% [].concat(locals.jsonld || []).forEach(function (j) { %><script type="application/ld+json"><%- JSON.stringify(j).replace(/</g, '\\u003c') %></script>
<% }) %>
<link rel="icon" href="/logo-mark.png">
<link rel="apple-touch-icon" href="/logo-mark.png">
<link rel="preload" href="/fonts/source-sans-3-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/fonts/montserrat-latin-800-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/store.css?v=<%= assetV %>">
</head>
<body>
<% const ann = settings['announcement_' + lang]; if (ann) { %>
<div class="topbar"><div class="wrap"><span><%= ann %></span><% if (settings.support_email) { %><span class="contact"><a href="mailto:<%= settings.support_email %>"><%= settings.support_email %></a><%= settings.support_phone ? ' · ' + settings.support_phone : '' %></span><% } %></div></div>
<% } %>
<header class="site">
  <div class="wrap nav">
    <a class="brand" href="/" aria-label="<%= settings.store_name %>">
      <img src="/logo-mark.png" alt="">
      <span class="word"><span class="name">EMPA<b>CALO</b></span><span class="sub">PACKING SUPPLIES</span></span>
    </a>
    <nav class="links">
      <a href="/#shop"><%= t('nav_shop') %></a>
      <a href="/#sizes"><%= t('nav_sizes') %></a>
      <a href="/#faq"><%= t('nav_faq') %></a>
      <a href="/track"><%= t('nav_track') %></a>
      <a href="/contact"><%= t('nav_contact') %></a>
    </nav>
    <div class="right">
      <span class="lang"><a href="?lang=en" class="<%= lang==='en'?'on':'' %>">EN</a> / <a href="?lang=es" class="<%= lang==='es'?'on':'' %>">ES</a></span>
      <a class="acct-link" href="<%= customer ? '/account' : '/account/login' %>"><%= customer ? t('nav_account') : t('nav_login') %></a>
      <a class="cart-btn" href="/cart"><span class="lbl"><%= t('nav_cart') %></span><span class="n"><%= cartCount %></span></a>
    </div>
  </div>
</header>
<main>
<% if (flash) { %><div class="wrap"><div class="flash <%= flash.type %>"><%= t(flash.key) %></div></div><% } %>
<% if (cartAdded) { %>
<div class="modal-back" id="added-modal">
  <div class="modal-box">
    <button type="button" class="modal-x" id="added-close" aria-label="<%= t('close') %>">&times;</button>
    <div class="modal-added-head">
      <span class="check">&#10003;</span><h3><%= t('modal_added_title') %></h3>
    </div>
    <div class="modal-added-item">
      <div class="thumb"><% if (cartAdded.image_id) { %><img src="/img/<%= cartAdded.image_id %>" alt=""><% } else { %><%- boxSvg('') %><% } %></div>
      <div>
        <div class="name"><%= (lang === 'es' && cartAdded.name_es) || cartAdded.name %></div>
        <div class="muted small"><%= t('qty') %>: <%= cartAdded.qty %> &middot; <%= money(cartAdded.price_cents * cartAdded.qty) %></div>
      </div>
    </div>
    <div class="modal-added-actions">
      <button type="button" class="btn ghost" id="added-continue"><%= t('modal_continue') %></button>
      <a class="btn orange" href="/cart"><%= t('modal_view_cart', { n: cartCount }) %></a>
    </div>
  </div>
</div>
<script>
(function () {
  var m = document.getElementById('added-modal');
  function close() { m.remove(); }
  document.getElementById('added-close').addEventListener('click', close);
  document.getElementById('added-continue').addEventListener('click', close);
  m.addEventListener('click', function (e) { if (e.target === m) close(); });
})();
</script>
<% } %>
