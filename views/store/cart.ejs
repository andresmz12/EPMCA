<%- include('_head') %>
<div class="wrap page">
  <h1 style="font-size:clamp(30px,4vw,44px)"><%= t('cart_title') %></h1>
  <% if (!priced.lines.length) { %>
    <div class="panel" style="text-align:center;padding:48px 20px">
      <p class="muted"><%= t('cart_empty') %></p>
      <a class="btn orange" href="/#shop"><%= t('continue_shopping') %></a>
    </div>
  <% } else { %>
  <div class="two">
    <form method="post" action="/cart/update" class="panel" id="cartform">
      <% priced.lines.forEach(function (l) { const p = l.product; %>
      <div class="line">
        <a class="thumb" href="/products/<%= p.slug %>"><%- include('_pic', { p, fixed: false }) %></a>
        <div>
          <a class="name" href="/products/<%= p.slug %>"><%= pt(p, 'name') %></a>
          <div class="muted small">
            <% if (l.unitCents < p.price_cents) { %><s><%= money(p.price_cents) %></s> <% } %><b style="color:var(--ink)"><%= money(l.unitCents) %></b> <%= t('per_box') %>
            <% if (l.unitCents < p.price_cents) { %> · <span class="ok" style="font-weight:700"><%= t('wholesale_applied') %></span><% } %>
          </div>
          <div class="controls">
            <input type="number" name="qty_<%= p.id %>" value="<%= l.qty %>" min="0" max="999" aria-label="<%= t('qty') %>">
            <button class="linkbtn" name="remove" value="<%= p.id %>"><%= t('remove') %></button>
          </div>
          <% if (l.overStock) { %><div class="stock out" style="margin-top:6px"><%= t('stock_warning', { n: p.stock }) %></div><% } %>
        </div>
        <div class="amt"><%= money(l.lineCents) %></div>
      </div>
      <% }) %>
      <div style="display:flex;justify-content:space-between;margin-top:16px;gap:12px;flex-wrap:wrap">
        <a class="btn sm ghost" href="/#shop"><%= t('continue_shopping') %></a>
        <button class="btn sm"><%= t('update') %></button>
      </div>
    </form>
    <aside class="panel gray">
      <h3><%= t('order_summary') %></h3>
      <% if (!priced.pickup && priced.lines.length && !priced.belowMin && (priced.freeUnits > 0 || priced.freeMin > 0) && (shippingInfo(settings).priced)) { %>
        <% const leftBoxes = priced.freeUnits - priced.boxUnits, leftMoney = priced.freeMin - (priced.subtotal - priced.discount);
           const freeNow = (priced.freeUnits > 0 && leftBoxes <= 0) || (priced.freeMin > 0 && leftMoney <= 0); %>
        <% if (freeNow) { %><div class="shipnote"><%= t('free_ship_ok') %></div>
        <% } else if (priced.freeUnits > 0) { %><div class="shipnote"><%= t(leftBoxes === 1 ? 'free_ship_units_left_1' : 'free_ship_units_left', { n: leftBoxes, units: priced.freeUnits }) %></div>
        <% } else if (priced.freeMin > 0) { %><div class="shipnote"><%= t('free_ship_left', { amount: money(leftMoney) }) %></div><% } %>
      <% } %>
      <%- include('_summary') %>
      <%- include('_coupon', { back: 'cart' }) %>
      <% if (priced.belowMin) { %><div class="shipnote" style="background:#FDECEA;border-color:#F3C7C2;color:#8A1F11"><%= t('min_boxes_note', { min: priced.minBoxes, n: priced.boxUnits, left: priced.minBoxes - priced.boxUnits }) %> <a class="textlink" href="/contact"><%= t('nav_contact') %></a></div><% } %>
      <% const blockedNoPickup = priced.belowMin && !(settings.pickup_enabled === 'true'); %>
      <a class="btn orange block <%= priced.lines.some(l => l.overStock) || blockedNoPickup ? 'disabled' : '' %>" href="/checkout" <%= priced.lines.some(l => l.overStock) || blockedNoPickup ? 'aria-disabled=true style=pointer-events:none;opacity:.45' : '' %>><%= t('checkout') %></a>
    </aside>
  </div>
  <% if (recurringEnabled && !priced.lines.some(l => l.overStock)) { %>
  <div class="panel" style="margin-top:20px">
    <h3><%= t('sub_title') %></h3>
    <p class="muted small" style="margin-bottom:14px"><%= t('sub_sub') %></p>
    <% if (customer) { %>
    <form method="post" action="/account/subscribe" style="display:flex;gap:12px;flex-wrap:wrap;align-items:center">
      <select name="interval" style="width:auto">
        <option value="week"><%= t('sub_weekly') %></option>
        <option value="month" selected><%= t('sub_monthly') %></option>
      </select>
      <button class="btn ghost"><%= t('sub_start') %></button>
    </form>
    <% } else { %>
      <a class="btn ghost" href="/account/login"><%= t('sub_login_first') %></a>
    <% } %>
  </div>
  <% } %>
  <% } %>
</div>
<%- include('_foot') %>
