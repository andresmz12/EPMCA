<%- include('_head') %>
<div class="wrap">
  <div class="crumbs"><a href="/#shop"><%= t('nav_shop') %></a> / <%= pt(product, 'name') %></div>
  <div class="pdp">
    <div>
      <div class="gallery <%= images.length ? 'has-img' : '' %>" id="mainpic">
        <% if (images.length) { %><img src="/img/<%= images[0] %>" alt="<%= pt(product, 'name') %>" id="mainpic-img">
        <% } else if (product.category === 'supply') { %><%- supplyIcon(product.slug) %>
        <% } else { %><%- boxSvg(product.dimensions) %><% } %>
      </div>
      <% if (images.length > 1) { %>
      <div class="thumbs">
        <% images.forEach(function (id, i) { %>
        <button type="button" class="thumb <%= i === 0 ? 'on' : '' %>" data-src="/img/<%= id %>"><img src="/img/<%= id %>" alt="" loading="lazy"></button>
        <% }) %>
      </div>
      <% } %>
    </div>
    <div>
      <h1><%= pt(product, 'name') %></h1>
      <p class="muted"><%= pt(product, 'short_desc') %></p>
      <% const tiers = wholesaleTiers(product); %>
      <div class="buybox">
        <div class="price" id="unitprice">
          <span id="unitprice-val"><%= money(product.price_cents) %></span><% if (product.compare_at_cents > product.price_cents) { %><s><%= money(product.compare_at_cents) %></s><span class="badge-off">-<%= Math.round((1 - product.price_cents / product.compare_at_cents) * 100) %>%</span><% } %>
          <span class="per"><%= product.pack_size > 1 ? '' : (product.category === 'supply' ? t('per_unit') : t('per_box')) %></span>
        </div>
        <% if (tiers.length) { %><div class="muted small" id="unitprice-hint" style="margin:-8px 0 10px"></div><% } %>
        <%- include('_stock', { p: product }) %>
        <table class="specs">
          <% if (product.category !== 'supply') { %>
          <tr><th><%= t('dimensions') %></th><td><%= product.dimensions || '—' %></td></tr>
          <tr><th><%= t('strength') %></th><td><%= product.wall_type === 'single' ? t('strength_val_single') : t('strength_val') %></td></tr>
          <% } %>
          <tr><th><%= t('nav_shipping') %></th><td><%= t('info_ship_d') %></td></tr>
        </table>
        <form method="post" action="/cart/add" class="buy" id="buyform" data-price="<%= product.price_cents %>" data-tiers='<%- JSON.stringify(tiers) %>'>
          <input type="hidden" name="product_id" value="<%= product.id %>">
          <input type="hidden" name="next" value="cart">
          <div class="qty">
            <button type="button" data-step="-1" aria-label="-">−</button>
            <input type="number" name="qty" id="qtyinput" value="<%= product.pack_size > 1 || product.category === 'supply' ? 1 : 10 %>" min="1" max="<%= Math.max(1, product.stock) %>" aria-label="<%= t('qty') %>">
            <button type="button" data-step="1" aria-label="+">+</button>
          </div>
          <button class="btn orange" <%= product.stock <= 0 ? 'disabled' : '' %>><%= product.stock <= 0 ? t('out_of_stock') : t('add_to_cart') %></button>
        </form>
        <% if (tiers.length) { %>
        <details class="wholesale-details">
          <summary><%= t('wholesale_title') %></summary>
          <p class="muted small"><%= t('wholesale_sub') %></p>
          <table class="specs">
            <tr><th><%= t('wholesale_col_qty') %></th><th class="num"><%= t('wholesale_col_price') %></th></tr>
            <% tiers.forEach(function (tier) { %>
            <tr><td><%= tier.qty %>+</td><td class="num"><%= money(tier.cents) %></td></tr>
            <% }) %>
          </table>
        </details>
        <% } %>
      </div>
      <div class="prose"><p><%= pt(product, 'description') %></p></div>
    </div>
  </div>
  <% if (others.length) { %>
  <div style="padding-bottom:72px">
    <h2 style="font-size:24px"><%= t('shop_title') %></h2>
    <div class="grid">
      <% others.forEach(function (p) { %>
      <article class="card">
        <a class="pic <%= p.image_id ? 'has-img' : '' %>" href="/products/<%= p.slug %>"><%- include('_pic', { p, fixed: true }) %></a>
        <div class="body"><a class="name" href="/products/<%= p.slug %>" style="font-size:16px"><%= pt(p, 'name') %></a><div class="price" style="font-size:17px"><%= money(p.price_cents) %></div></div>
      </article>
      <% }) %>
    </div>
  </div>
  <% } %>
</div>
<% if (images.length > 1) { %>
<script>
(function () {
  var img = document.getElementById('mainpic-img');
  document.querySelectorAll('.thumbs .thumb').forEach(function (b) {
    b.addEventListener('click', function () {
      img.src = b.dataset.src;
      document.querySelectorAll('.thumbs .thumb').forEach(function (x) { x.classList.remove('on'); });
      b.classList.add('on');
    });
  });
})();
</script>
<% } %>
<script>
(function () {
  var form = document.getElementById('buyform');
  if (!form) return;
  var qtyInput = document.getElementById('qtyinput');
  var valEl = document.getElementById('unitprice-val');
  var hintEl = document.getElementById('unitprice-hint');
  var basePrice = Number(form.dataset.price);
  var tiers = JSON.parse(form.dataset.tiers || '[]');
  function fmt(cents) { return '$' + (cents / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
  function update() {
    var qty = parseInt(qtyInput.value, 10) || 0;
    var price = basePrice, next = null;
    tiers.forEach(function (t) {
      if (qty >= t.qty) price = t.cents;
      else if (next === null) next = t;
    });
    valEl.textContent = fmt(price);
    if (hintEl) {
      hintEl.textContent = price < basePrice
        ? '<%= t("wholesale_applied") %>'
        : (next ? '<%= t("wholesale_col_qty") %> ' + next.qty + '+: ' + fmt(next.cents) + ' <%= t("per_box") %>' : '');
    }
  }
  qtyInput.addEventListener('input', update);
  update();
})();
</script>
<%- include('_foot') %>
