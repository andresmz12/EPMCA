</main>
<footer class="site">
  <div class="wrap">
    <div class="cols">
      <div>
        <a class="brand" href="/"><img src="/logo-mark.png" alt="" style="background:#fff;border-radius:3px;padding:2px"><span class="word"><span class="name">EMPA<b>CALO</b></span><span class="sub">PACKING SUPPLIES</span></span></a>
        <p style="margin-top:14px;max-width:340px"><%= t('hero_sub') %></p>
      </div>
      <div>
        <h4><%= t('nav_shop') %></h4>
        <p><a href="/#shop"><%= t('nav_shop') %></a></p>
        <p><a href="/#sizes"><%= t('nav_sizes') %></a></p>
        <p><a href="/#faq"><%= t('nav_faq') %></a></p>
        <p><a href="/#shipping"><%= t('nav_shipping') %></a></p>
      </div>
      <div>
        <h4><%= t('footer_contact') %></h4>
        <p><a href="/track"><%= t('nav_track') %></a></p>
        <p><a href="/contact"><%= t('nav_contact') %></a></p>
        <% if (settings.support_email) { %><p><a href="mailto:<%= settings.support_email %>"><%= settings.support_email %></a></p><% } %>
        <% if (settings.support_phone) { %><p><a href="tel:<%= settings.support_phone.replace(/[^\d+]/g,'') %>"><%= settings.support_phone %></a></p><% } %>
        <p><%= t('info_ship_d') %></p>
      </div>
    </div>
    <div class="legal">© <%= new Date().getFullYear() %> <%= settings.store_name %>. <%= t('footer_rights') %></div>
  </div>
</footer>
<% if (settings.whatsapp_number) {
  const waMsg = locals.product ? t('wa_product', { name: pt(locals.product, 'name') }) : t('wa_general'); %>
<a class="wa-float" href="https://wa.me/<%= settings.whatsapp_number %>?text=<%= encodeURIComponent(waMsg) %>" target="_blank" rel="noopener" aria-label="<%= t('wa_label') %>">
  <svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.6-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.8-1.3c.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3z"/></svg>
  <span><%= t('wa_label') %></span>
</a>
<% } %>
<script>
document.querySelectorAll('form[data-confirm]').forEach(function (f) {
  f.addEventListener('submit', function (e) { if (!window.confirm(f.dataset.confirm)) e.preventDefault(); });
});
document.querySelectorAll('[data-step]').forEach(function (b) {
  b.addEventListener('click', function () {
    var i = b.parentNode.querySelector('input'); var v = (parseInt(i.value, 10) || 0) + parseInt(b.dataset.step, 10);
    var max = parseInt(i.max, 10) || 999; i.value = Math.max(parseInt(i.min, 10) || 1, Math.min(v, max));
  });
});
</script>
</body>
</html>
