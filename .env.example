# Copia este archivo como .env para correr en tu computador (en Railway se ponen en "Variables").
DATABASE_URL=postgres://usuario:clave@localhost:5432/empacalo
SESSION_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
ADMIN_EMAIL=tu-correo@empacalo.net
ADMIN_PASSWORD=una-contraseña-fuerte
NODE_ENV=production

# Opcional: pagos con tarjeta
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional: dominio público (si no, se detecta solo)
PUBLIC_URL=
# Opcional: correos automáticos con SendGrid
SENDGRID_API_KEY=
EMAIL_FROM=pedidos@empacalo.us
EMAIL_FROM_NAME=EMPACALO
